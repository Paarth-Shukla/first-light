        <item rdf:about="https://www.nature.com/articles/d41586-026-03515-z">
            <title><![CDATA[How to avoid aliens and live]]></title>
            <link>https://www.nature.com/articles/d41586-026-03515-z</link>
            <content:encoded>
                <![CDATA[<p>Nature, Published online: 11 November 2026; <a href="https://www.nature.com/articles/d41586-026-03515-z">doi:10.1038/d41586-026-03515-z</a></p>Silence is golden.]]></content:encoded>
